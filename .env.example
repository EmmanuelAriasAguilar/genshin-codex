# Backend
# Postgres (docker compose expone 5433). Cambiar si usas otra DB.
DATABASE_URL=postgres://codex:codex@localhost:5433/genshin_codex
# Puerto del backend Effect
PORT=4901
# Token para escrituras (admin). Si se deja vacío, las escrituras NO requieren auth (solo dev).
ADMIN_TOKEN=

# Frontend
# URL del backend a la que el frontend proxea /api
BACKEND_URL=http://localhost:4901
